{
  "name": "@chameleon-labs/lattice-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "The token layer of Lattice, an accessibility-first design system. Reviewed contracts guard colour, typography, and layout values at build time.",
  "license": "MIT",
  "author": "George Karan",
  "homepage": "https://github.com/chameleon-labs/lattice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chameleon-labs/lattice.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/chameleon-labs/lattice/issues",
  "keywords": [
    "design-system",
    "design-tokens",
    "color",
    "typography",
    "oklch",
    "accessibility",
    "wcag"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./lattice.css": "./dist/lattice.css",
    "./tokens.json": "./dist/tokens.json",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsx generate/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
